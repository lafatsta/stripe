html
  head
    title=title
    script(src='https://js.stripe.com/v3/')
    script(defer, src='checkout.js')
  body    
    h1=title
    ul
      each val in items
          h1= val.price_data.product_data.name
            |
          if val.price_data && val.price_data.product_data && val.price_data.product_data.images && val.price_data.product_data.images.length
            img(src=val.price_data.product_data.images[0])
            |
          h2 Quantity: #{val.quantity}
            |
          h3 Total Amount: $#{(val.price_data.unit_amount * val.quantity) / 100} USD
            |
          P *****************************************************************************************************
      else
          li There is nothing in the cart
    if items && items.length
      button(id='submit' pk=pk sessionID=sessionID) Pay Now
    if checkoutError
      #checkoutError= checkoutError
    a(href='/shop') Go back to Shopping!